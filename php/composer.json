{
    "name": "skunkwerkx/hypercast-dev",
    "description": "Development harness for the hypercast PHP extension",
    "type": "library",
    "keywords": ["parsing", "parser", "cast", "validation", "decimal", "datetime", "uuid", "extension", "rust"],
    "license": "(MIT and Unicode-3.0)",
    "authors": [
        {
            "name": "Brian Buvinghausen"
        }
    ],
    "homepage": "https://github.com/SkunkWerkx/HyperCast",
    "support": {
        "issues": "https://github.com/SkunkWerkx/HyperCast/issues",
        "source": "https://github.com/SkunkWerkx/HyperCast"
    },
    "require": {
        "php": ">=8.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0",
        "phpbench/phpbench": "^1.7",
        "squizlabs/php_codesniffer": "^3.10 || ^4.0"
    },
    "autoload-dev": {
        "psr-4": {
            "HyperCast\\Tests\\": "tests/",
            "HyperCast\\Bench\\": "bench/"
        }
    },
    "scripts": {
        "test": "@php tools/run-tests.php",
        "bench": "@php tools/run-bench.php"
    }
}
