[
  { "type": "f64", "input": "1.5", "expect": "ok", "value": 1.5 },
  { "type": "f64", "input": "  2.25  ", "expect": "ok", "value": 2.25 },
  { "type": "f64", "input": "-3.5", "expect": "ok", "value": -3.5 },
  { "type": "f64", "input": "1,234.5", "expect": "ok", "value": 1234.5 },
  { "type": "f64", "input": "(2.5)", "expect": "ok", "value": -2.5 },
  { "type": "f64", "input": "2.5e3", "expect": "ok", "value": 2500.0 },
  { "type": "f64", "input": "2.5e-3", "expect": "ok", "value": 0.0025 },
  { "type": "f64", "input": "50%", "expect": "ok", "value": 0.5 },
  { "type": "f64", "input": "25.5%", "expect": "ok", "value": 0.255 },
  { "type": "f64", "input": "(2.5)%", "expect": "ok", "value": -0.025 },
  { "type": "f64", "input": ".5", "expect": "ok", "value": 0.5 },
  { "type": "f64", "input": "1e39", "expect": "ok", "value": 1e39 },
  { "type": "f32", "input": "1.5", "expect": "ok", "value": 1.5 },
  { "type": "f64", "input": "1.234,5", "format": { "decimal_sep": ",", "group_sep": ".", "flags": 31 }, "expect": "ok", "value": 1234.5 },
  { "type": "f64", "input": "1 234,5", "format": { "decimal_sep": ",", "group_sep": " ", "flags": 31 }, "expect": "ok", "value": 1234.5 },
  { "type": "f64", "input": "NaN", "expect": "malformed" },
  { "type": "f64", "input": "Infinity", "expect": "malformed" },
  { "type": "f64", "input": "-Infinity", "expect": "malformed" },
  { "type": "f64", "input": "inf", "expect": "malformed" },
  { "type": "f64", "input": "1e400", "expect": "out_of_range", "fault": [0, 5] },
  { "type": "f32", "input": "1e39", "expect": "out_of_range" },
  { "type": "f64", "input": "abc", "expect": "malformed", "fault": [0, 1] },
  { "type": "f64", "input": "1.2.3", "expect": "malformed", "fault": [3, 1] },
  { "type": "f64", "input": "%", "expect": "malformed" },
  { "type": "f64", "input": "1,234.5,6", "expect": "malformed" },
  { "type": "f64", "input": "", "expect": "empty" },
  { "type": "f64", "input": " \t\r\n\f ", "expect": "empty" },
  { "type": "f64", "input": "50%", "format": { "decimal_sep": ".", "group_sep": ",", "flags": 0 }, "expect": "malformed" }
]
