# frozen_string_literal: true

source "https://rubygems.org"

gemspec

# The test and benchmark gems; rake and yard are the gemspec's own development
# dependencies, since `rake build` and `rake docs:check` are part of packaging the gem.
group :development do
  gem "benchmark-ips", "~> 2.15"
  # Bundled (not default) gem since Ruby 3.4, so Bundler only sees it when named here: the
  # suite exercises Decimal#to_d, which requires it lazily. Consumers stay free of it —
  # the gemspec declares nothing beyond Fiddle.
  gem "bigdecimal"
  gem "rspec", "~> 3.13"
  # The formatter: .rubocop.yml enables the layout cops only, over lib, spec and benchmark.
  gem "rubocop", "~> 1.91", require: false
end
