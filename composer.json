{
    "name": "skunkwerkx/hypercast",
    "description": "Allocation-free scalar parsing as Success/Fault verdicts — direct native FFI into a Rust core, no runtime bridge.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Brian Buvinghausen"
        }
    ],
    "homepage": "https://github.com/SkunkWerkx/HyperCast",
    "require": {
        "php": ">=8.1",
        "ext-ffi": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpbench/phpbench": "^1.7",
        "squizlabs/php_codesniffer": "^3.10"
    },
    "autoload": {
        "psr-4": {
            "HyperCast\\": "php/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "HyperCast\\Tests\\": "php/tests/",
            "HyperCast\\Bench\\": "php/bench/"
        }
    }
}
