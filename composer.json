{
    "name": "skunkwerkx/hypercast",
    "description": "Allocation-free scalar parsing as Success/Fault verdicts — a PHP extension over a Rust core, installed with PIE.",
    "type": "php-ext",
    "keywords": ["parsing", "parser", "cast", "validation", "decimal", "datetime", "uuid", "extension", "rust"],
    "license": "MIT",
    "authors": [
        {
            "name": "Brian Buvinghausen"
        }
    ],
    "homepage": "https://github.com/SkunkWerkx/HyperCast",
    "support": {
        "issues": "https://github.com/SkunkWerkx/HyperCast/issues",
        "source": "https://github.com/SkunkWerkx/HyperCast"
    },
    "require": {
        "php": ">=8.3"
    },
    "php-ext": {
        "extension-name": "hypercast",
        "support-nts": true,
        "support-zts": false,
        "download-url-method": ["pre-packaged-binary"],
        "os-families": ["linux", "darwin", "windows"]
    }
}
