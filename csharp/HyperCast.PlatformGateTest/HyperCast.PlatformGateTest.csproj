<Project Sdk="Microsoft.NET.Sdk">

	<!-- Exists only for the HYPERCAST003 probes, and is not in HyperCast.slnx. It has no source
	     and no references: it imports the shipped targets file by hand, in the project body
	     the way the smoke tests do, and a probe picks the framework and RID from the command
	     line, for example
	       dotnet build -p:GateFramework=net10.0-ios
	       dotnet msbuild -getProperty:_HyperCastNet10Unsupported -p:GateFramework=net10.0-android
	     with an optional -p:RuntimeIdentifier=browser-wasm. TargetFrameworks is cleared so
	     Directory.Build.props' net10.0;net11.0 does not turn the probe into a multi-target build. -->
	<PropertyGroup>
		<TargetFrameworks></TargetFrameworks>
		<TargetFramework>$(GateFramework)</TargetFramework>
		<IsPackable>false</IsPackable>
	</PropertyGroup>

	<Import Project="../HyperCast/build/net10.0/HyperCast.targets" />

</Project>
