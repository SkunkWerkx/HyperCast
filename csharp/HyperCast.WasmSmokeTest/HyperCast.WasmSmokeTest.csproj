<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <!-- TargetFrameworks (net10.0;net11.0), LangVersion and Nullable/ImplicitUsings come from
       csharp/Directory.Build.props, shared with every project here. -->
  <PropertyGroup>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <StaticWebAssetSpaFallbackEnabled>true</StaticWebAssetSpaFallbackEnabled>
  </PropertyGroup>

  <!-- Both frameworks the package serves in the browser, published one at a time (check.sh
       passes -f). check.sh serves the publish output statically, so neither needs a dev
       server; the Gateway package, the static web assets host .NET 11's template adds, stays
       on net11.0. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.*" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net11.0'">
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="11.*-*" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Gateway" Version="11.*-*" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- The managed binding, through its real public surface: this app declares no P/Invokes
         of its own, because Cast declares every entry point twice ("hypercast" for dlopen
         platforms, "*" for the statically linked wasm module) and picks at the call site
         with OperatingSystem.IsBrowser(). -->
    <ProjectReference Include="../HyperCast/HyperCast.csproj" />
  </ItemGroup>

  <!-- What a NuGet consumer gets for free and a ProjectReference does not: the package's
       build/net10.0/HyperCast.targets is only auto-imported from a restored package. Importing
       it by hand means this app links through the *shipped* NativeFileReference rather than
       a copy of it, so an archive that is not linked fails here exactly as it would for a real
       Blazor consumer (v0.0.1's `undefined symbol: cast_i32`).

       Needs the wasm32-unknown-emscripten staticlib staged where the targets file looks for
       it, csharp/HyperCast/runtimes/browser-wasm/nativeassets/net11.0/libhypercast.a, which
       is gitignored like every other runtimes/ asset. check.sh stages it. -->
  <Import Project="../HyperCast/build/net10.0/HyperCast.targets" />

</Project>
