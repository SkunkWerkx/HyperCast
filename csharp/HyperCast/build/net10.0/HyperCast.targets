<Project>
  <!-- Auto-imported into every consuming project via NuGet's build/{tfm}/{PackageId}.targets
       convention. A .targets file rather than .props specifically because it needs
       $(RuntimeIdentifier) already resolved, which for a Blazor WebAssembly project only
       happens after that project's own Sdk.targets import; a .props file is imported before
       the project body and would run too early to see it.

       Ported from HyperUuid, whose C# binding hit the trap below first and paid for it with a
       real headless-Chromium session. HyperCast's first publish (v0.0.1) shipped
       without this file at all, and a Blazor wasm build against the package from nuget.org
       failed at wasm-ld with "undefined symbol: cast_i32" and one line per door called.

       The NativeFileReference is the whole wiring. NuGet's runtimes/{rid}/nativeassets/{tfm}/
       package convention is real, and the WASM SDK's WasmApp.Common.targets does auto-promote
       @(NativeLibrary) into @(NativeFileReference) — but restore never populates
       @(NativeLibrary) from a plain PackageReference's nativeassets folder the way it does
       runtimes/{rid}/native/ for ordinary P/Invoke. So without this item the staticlib ships,
       sits on disk, and is never handed to the linker. With it, the SDK scans every assembly's
       P/Invokes and generates a pinvoke table that calls each door by symbol, so the link itself
       resolves them against the archive (with the archive missing, wasm-ld fails with an
       undefined symbol per door) and LibraryImport("*") reaches each one
       through that table. No @(EmccExportedFunction) list is needed, because "*" resolution
       does not need the Emscripten export: HyperCast.WasmSmokeTest calls all twenty-seven
       entry points without one on .NET SDK 11.0.100-rc.2, and fails at the link with the
       archive unlinked.

       nativeassets/net11.0/ is the forge's spelling for the staticlib directory, shared with
       HyperUuid's package, and .NET 10 and 11 link it alike. It is only a folder name: the
       reference below names the path directly, so nothing selects on it.

       Two frameworks, one file. The package carries lib/net10.0/ and lib/net11.0/, and this
       file sits once under build/net10.0/ (with buildTransitive/net10.0/'s copy beside it):
       NuGet picks the nearest build/{tfm}/ folder, and net10.0 is the nearest one for both
       net10.0 and net11.0 projects, so there is no build/net11.0/ copy to keep in step. A
       project older than .NET 10 is refused at restore (NU1202).

       On .NET 10 the file serves Windows, Linux and macOS, framework-dependent or Native AOT,
       and Blazor WebAssembly, and refuses the platforms that need .NET 11 with HYPERCAST003
       (the gate below): Android, iOS and Mac Catalyst. The gate reads $(TargetFramework), not
       $(TargetFrameworkVersion) or $(TargetPlatformIdentifier): the projects that import this
       file by hand do it in the project body, before the SDK has set those, and they are
       empty there (a NuGet import runs after them). The TargetFramework functions give the
       same answer in both places. It hooks _CheckForInvalidConfigurationAndPlatform so that
       it speaks first, ahead of the Xcode and JDK checks the platform SDKs run, which would
       otherwise answer with their own message. Every other block below stands aside when the
       gate fires, so a refused build reports one diagnostic. HyperUuid's copy of this file is
       laid out the same way, with HYPERUUID003. -->
  <!-- HYPERCAST003: the platforms .NET 10 cannot serve. Evaluated here, at the top, so every
       block below can stand aside on _HyperCastNet10Unsupported. Windows desktop
       (net10.0-windows) and net10.0-macos are not matched and build as before. -->
  <PropertyGroup Condition="'$([MSBuild]::GetTargetFrameworkIdentifier($(TargetFramework)))' == '.NETCoreApp' And $([MSBuild]::VersionLessThan($([MSBuild]::GetTargetFrameworkVersion($(TargetFramework))), '11.0'))">
    <_HyperCastNet10Platform>$([MSBuild]::GetTargetPlatformIdentifier($(TargetFramework)))</_HyperCastNet10Platform>
    <_HyperCastNet10Unsupported Condition="'$(_HyperCastNet10Platform)' == 'android'">Android</_HyperCastNet10Unsupported>
    <_HyperCastNet10Unsupported Condition="'$(_HyperCastNet10Unsupported)' == '' And '$(_HyperCastNet10Platform)' == 'ios'">iOS</_HyperCastNet10Unsupported>
    <_HyperCastNet10Unsupported Condition="'$(_HyperCastNet10Unsupported)' == '' And '$(_HyperCastNet10Platform)' == 'maccatalyst'">Mac Catalyst</_HyperCastNet10Unsupported>
    <_HyperCastNet10Tfm Condition="'$(_HyperCastNet10Unsupported)' == 'Android'">net11.0-android</_HyperCastNet10Tfm>
    <_HyperCastNet10Tfm Condition="'$(_HyperCastNet10Unsupported)' == 'iOS'">net11.0-ios</_HyperCastNet10Tfm>
    <_HyperCastNet10Tfm Condition="'$(_HyperCastNet10Unsupported)' == 'Mac Catalyst'">net11.0-maccatalyst</_HyperCastNet10Tfm>
  </PropertyGroup>

  <Target Name="_HyperCastErrorUnsupportedNet10Platform"
          BeforeTargets="_CheckForInvalidConfigurationAndPlatform"
          Condition="'$(_HyperCastNet10Unsupported)' != ''">
    <Error Code="HYPERCAST003"
           Text="HyperCast supports .NET 10 on Windows, Linux and macOS, framework-dependent or Native AOT, and in Blazor WebAssembly. $(_HyperCastNet10Unsupported) needs .NET 11 or later: target $(_HyperCastNet10Tfm)." />
  </Target>

  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'browser-wasm' And '$(_HyperCastNet10Unsupported)' == ''">
    <NativeFileReference Include="$(MSBuildThisFileDirectory)../../runtimes/browser-wasm/nativeassets/net11.0/libhypercast.a" />
  </ItemGroup>

  <!-- The link above happens only where the wasm-tools workload is installed. Without it the
       SDK never relinks the runtime: @(NativeFileReference) is skipped with nothing louder
       than the SDK's own warning, the publish succeeds, and the app ships the stock
       dotnet.native.wasm with no cast_* symbols in it. NETSDK1147 does not fire for this,
       and setting WasmBuildNative from here cannot make it: the workload manifest decides
       whether the workload is needed before NuGet's package targets are imported.
       WasmNativeWorkloadAvailable is settled by then, so the check reads it directly and
       stops the build. An app that gates on Cast.IsAvailable and keeps a managed fallback
       can set HyperCastRequireWasmWorkload to false. HyperUuid's package carries the same
       check, as HYPERUUID002; the code is numbered to match it, and 001 is unused in all
       three packages. -->
  <Target Name="_HyperCastErrorWasmWorkloadMissing"
          BeforeTargets="BeforeBuild"
          Condition="'$(RuntimeIdentifier)' == 'browser-wasm' And '$(WasmNativeWorkloadAvailable)' != 'true' And '$(HyperCastRequireWasmWorkload)' != 'false' And '$(_HyperCastNet10Unsupported)' == ''">
    <Error Code="HYPERCAST002"
           Text="HyperCast's WebAssembly support links its native core into the runtime, which needs the wasm-tools workload, and it is not installed. Without it the publish succeeds but the app has no cast_* symbols, Cast.IsAvailable is false in the browser and every Cast call throws. Run 'dotnet workload install wasm-tools' (a net10.0 app built with the .NET 11 SDK takes 'wasm-tools-net10'), or set HyperCastRequireWasmWorkload to false if the app keeps a managed fallback." />
  </Target>

  <!-- The archive is linked by the path above, and nothing else is supposed to touch it. But
       restore resolves runtimes/browser-wasm/nativeassets/ as a copy-local native asset for
       this RID, so without this the archive was copied into bin/ and the publish root of
       every Blazor WebAssembly consumer, never served and never read. Taken back out of
       @(NativeCopyLocalItems), which is where restore puts it, before anything copies it.
       HyperUuid's package carries the same target for its own archive. -->
  <Target Name="_HyperCastDropWasmArchiveFromCopyLocal"
          AfterTargets="ResolvePackageAssets"
          Condition="'$(RuntimeIdentifier)' == 'browser-wasm' And '$(_HyperCastNet10Unsupported)' == ''">
    <ItemGroup>
      <NativeCopyLocalItems Remove="@(NativeCopyLocalItems)"
                            Condition="'%(NativeCopyLocalItems.NuGetPackageId)' == 'HyperCast' And '%(NativeCopyLocalItems.Filename)%(NativeCopyLocalItems.Extension)' == 'libhypercast.a'" />
    </ItemGroup>
  </Target>

  <!-- iOS and Mac Catalyst: link the core in, always.

       An app on these platforms has no runtimes/{rid}/native/ to load a library from: the
       .NET SDK for them links native code into the app's own executable, and a P/Invoke
       reaches it under the library name "__Internal" (Cast.cs declares every entry point a
       third time against that name, picked by OperatingSystem.IsIOS(), which is true on Mac
       Catalyst too). NativeReference with Kind=Static is the item that SDK links, the same
       one a binding project uses, and it is the SDK's own native link that consumes it
       whether the app is compiled by Mono's AOT compiler, runs interpreted, or is published
       with Native AOT. So this is one branch for all three, and the Native AOT block below
       stands aside for these RIDs: its DirectPInvoke and NativeLibrary items are for ILC's
       own link, which is not the one that runs here.

       The archives are the same no_std static libraries, in staticlibs/{rid}/ for
       ios-arm64, iossimulator-arm64, maccatalyst-arm64 and maccatalyst-x64. A universal Mac
       Catalyst app (RuntimeIdentifiers with both) is built once per RID and merged by the
       SDK, and each of those inner builds evaluates this with its own RuntimeIdentifier. An
       RID with no archive here (iossimulator-x64, tvOS) gets nothing, and the app fails at
       its native link on the undefined cast_* symbols: at build time, not at run time. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != '' And '$(_HyperCastNet10Unsupported)' == ''">
    <_HyperCastAppleMobile Condition="$(RuntimeIdentifier.StartsWith('ios-')) Or $(RuntimeIdentifier.StartsWith('iossimulator-')) Or $(RuntimeIdentifier.StartsWith('maccatalyst-'))">true</_HyperCastAppleMobile>
    <_HyperCastAppleMobileLibrary Condition="'$(_HyperCastAppleMobile)' == 'true'">$(MSBuildThisFileDirectory)../../staticlibs/$(RuntimeIdentifier)/libhypercast.a</_HyperCastAppleMobileLibrary>
  </PropertyGroup>

  <ItemGroup Condition="'$(_HyperCastAppleMobile)' == 'true' And Exists('$(_HyperCastAppleMobileLibrary)') And '$(_HyperCastNet10Unsupported)' == ''">
    <NativeReference Include="$(_HyperCastAppleMobileLibrary)" Kind="Static" />
  </ItemGroup>

  <!-- Native AOT: link the core in.

       Without this, a Native AOT publish produces an executable with libhypercast.so (or the
       .dylib, or the .dll) sitting beside it, opened on first use like any other P/Invoke. Here it is
       linked into the executable instead: DirectPInvoke tells the AOT compiler to bind every
       import from "hypercast" as a direct call to a symbol the linker must resolve, and
       NativeLibrary hands the linker the archive that defines them. The result is one file,
       and calls that are plain calls, with no lazy binding stub in front of them.

       The archives are in staticlibs/{rid}/, one per RID the package carries a shared
       library for, built without Rust's standard library so that this package and
       HyperUuid's can both be linked into one executable (the same collision, and the same
       fix, as the Blazor WebAssembly archive above).

       Presence decides. Where the package has no archive for the RID being published — a
       RID it has never heard of, or a package built before these existed — nothing here
       applies and the publish loads the shared library exactly as it always did. Setting
       HyperCastStaticLink to false asks for that on purpose.

       Not for browser-wasm or for iOS and Mac Catalyst, which have their own wiring above,
       and not for anything but an AOT publish: a JIT process cannot link an archive, so it
       still loads the shared library. -->
  <PropertyGroup Condition="'$(PublishAot)' == 'true' And '$(RuntimeIdentifier)' != '' And '$(RuntimeIdentifier)' != 'browser-wasm' And '$(_HyperCastAppleMobile)' != 'true' And '$(HyperCastStaticLink)' != 'false' And '$(_HyperCastNet10Unsupported)' == ''">
    <_HyperCastStaticLibrary Condition="$(RuntimeIdentifier.StartsWith('win'))">$(MSBuildThisFileDirectory)../../staticlibs/$(RuntimeIdentifier)/hypercast.lib</_HyperCastStaticLibrary>
    <_HyperCastStaticLibrary Condition="!$(RuntimeIdentifier.StartsWith('win'))">$(MSBuildThisFileDirectory)../../staticlibs/$(RuntimeIdentifier)/libhypercast.a</_HyperCastStaticLibrary>
    <_HyperCastStaticLibrary Condition="!Exists('$(_HyperCastStaticLibrary)')"></_HyperCastStaticLibrary>
  </PropertyGroup>

  <ItemGroup Condition="'$(_HyperCastStaticLibrary)' != '' And '$(_HyperCastNet10Unsupported)' == ''">
    <DirectPInvoke Include="hypercast" />
    <NativeLibrary Include="$(_HyperCastStaticLibrary)" />
  </ItemGroup>

  <!-- With the core linked in, the shared library is dead weight in the publish directory:
       nothing opens it. It gets there two ways — NuGet's runtimes/{rid}/native/ asset for a
       package consumer, a copy-to-output item for a project reference — and both end up in
       @(ResolvedFileToPublish), which is where it is taken back out. By file name, since
       that is all the two routes have in common; the managed assembly is HyperCast.Managed.dll
       and is not in an AOT publish anyway. -->
  <Target Name="_HyperCastDropSharedLibraryFromAotPublish"
          AfterTargets="ComputeResolvedFilesToPublishList"
          Condition="'$(_HyperCastStaticLibrary)' != '' And '$(_HyperCastNet10Unsupported)' == ''">
    <ItemGroup>
      <_HyperCastSharedLibrary Include="@(ResolvedFileToPublish)"
                         Condition="'%(Filename)%(Extension)' == 'libhypercast.so' Or '%(Filename)%(Extension)' == 'libhypercast.dylib' Or '%(Filename)%(Extension)' == 'hypercast.dll'" />
      <ResolvedFileToPublish Remove="@(_HyperCastSharedLibrary)" />
    </ItemGroup>
  </Target>
</Project>
