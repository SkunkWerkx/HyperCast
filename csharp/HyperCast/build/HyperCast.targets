<Project>
  <!-- Auto-imported into every consuming project via NuGet's build/{tfm}/{PackageId}.targets
       convention. A .targets file rather than .props specifically because it needs
       $(RuntimeIdentifier) already resolved, which for a Blazor WebAssembly project only
       happens after that project's own Sdk.targets import; a .props file is imported before
       the project body and would run too early to see it.

       Ported from HyperUuid, whose C# binding hit both of the traps below first and paid for
       them with a real headless-Chromium session. HyperCast's first publish (v0.0.1) shipped
       without this file at all, and a Blazor wasm build against the package from nuget.org
       failed at wasm-ld with "undefined symbol: cast_i32" and one line per door called.

       Two separate things are required, and having only the first is the dangerous state:

       1. NativeFileReference. NuGet's runtimes/{rid}/nativeassets/{tfm}/ package convention is
          real, and the WASM SDK's WasmApp.Common.targets does auto-promote @(NativeLibrary)
          into @(NativeFileReference) — but restore never populates @(NativeLibrary) from a
          plain PackageReference's nativeassets folder the way it does runtimes/{rid}/native/
          for ordinary P/Invoke. So the staticlib ships, sits on disk, and is never handed to
          the linker.

       2. EmccExportedFunction, one per door. Linking the staticlib in does NOT make its
          functions resolvable through LibraryImport("*") at runtime. The WASM SDK's emcc
          invocation exports only the runtime's own baseline functions (malloc, free, the math
          intrinsics) from wasm-props.json; it never scans P/Invoke declarations in the app's
          assembly or in any referenced package to work out what else to export. Every native
          function Cast.cs P/Invokes has to be named here, Emscripten style with a leading
          underscore, or it links in and stays invisible.

       With only 1, the build succeeds and the app throws at runtime instead of failing at the
       link, which is strictly worse than the original bug.

       net10.0 is the forge's own spelling for the staticlib directory, shared with HyperUuid's
       package. It is only a folder name here: the reference below names the path directly, so
       nothing selects on it and no rename is needed for this package's net11.0 consumers.

       No target-framework gate, unlike HyperUuid's copy of this file, and no
       target-framework folder either: this package targets net11.0 and nothing older, so
       NuGet cannot install it into a project that predates the .NET 11 WebAssembly
       toolchain the last item group depends on. -->
  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'browser-wasm'">
    <NativeFileReference Include="$(MSBuildThisFileDirectory)../runtimes/browser-wasm/nativeassets/net10.0/libhypercast.a" />
    <EmccExportedFunction Include="_cast_bool" />
    <EmccExportedFunction Include="_cast_i8" />
    <EmccExportedFunction Include="_cast_i16" />
    <EmccExportedFunction Include="_cast_i32" />
    <EmccExportedFunction Include="_cast_i64" />
    <EmccExportedFunction Include="_cast_u8" />
    <EmccExportedFunction Include="_cast_u16" />
    <EmccExportedFunction Include="_cast_u32" />
    <EmccExportedFunction Include="_cast_u64" />
    <EmccExportedFunction Include="_cast_f32" />
    <EmccExportedFunction Include="_cast_f64" />
    <EmccExportedFunction Include="_cast_decimal" />
    <EmccExportedFunction Include="_cast_uuid" />
    <EmccExportedFunction Include="_cast_timestamp" />
    <EmccExportedFunction Include="_cast_unix" />
    <EmccExportedFunction Include="_cast_excel_serial" />
    <EmccExportedFunction Include="_cast_date" />
    <EmccExportedFunction Include="_cast_date_ordered" />
    <EmccExportedFunction Include="_cast_datetime" />
    <EmccExportedFunction Include="_cast_time" />
    <EmccExportedFunction Include="_cast_duration" />
    <EmccExportedFunction Include="_hypercast_version" />
  </ItemGroup>

  <!-- .NET 11 and later link browser-wasm with the new (exnref) exception-handling encoding,
       while Rust's precompiled core and compiler_builtins inside the emscripten staticlib use
       the legacy one (the staticlib is built without std, and that did not change this:
       re-tested, and the browser still refuses the module without the pass). The link succeeds and the SDK's wasm-opt passes the
       mix through, then the browser refuses to compile the module: "module uses a mix of
       legacy and new exception handling instructions". Binaryen's translate-to-exnref pass
       rewrites the legacy instructions into the new encoding so the module is uniform.
       Appended to the SDK's own post-link wasm-opt step through @(WasmOptConfigurationFlags).
       WebAssembly support is .NET 11 and later only, so there is no gate on the target
       framework.

       Exclude names the item list itself, so the flag is added once however many packages
       ask for it: an app that references both HyperUuid and HyperCast imports both files,
       and without this wasm-opt was handed the pass twice. -->
  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'browser-wasm'">
    <WasmOptConfigurationFlags Include="--translate-to-exnref" Exclude="@(WasmOptConfigurationFlags)" />
  </ItemGroup>

  <!-- The archive is linked by the path above, and nothing else is supposed to touch it. But
       restore resolves runtimes/browser-wasm/nativeassets/ as a copy-local native asset for
       this RID, so without this the 3 MB archive was copied into bin/ and the publish root of
       every Blazor WebAssembly consumer, never served and never read. Taken back out of
       @(NativeCopyLocalItems), which is where restore puts it, before anything copies it.
       HyperUuid's package carries the same target for its own archive. -->
  <Target Name="_HyperCastDropWasmArchiveFromCopyLocal"
          AfterTargets="ResolvePackageAssets"
          Condition="'$(RuntimeIdentifier)' == 'browser-wasm'">
    <ItemGroup>
      <NativeCopyLocalItems Remove="@(NativeCopyLocalItems)"
                            Condition="'%(NativeCopyLocalItems.NuGetPackageId)' == 'HyperCast' And '%(NativeCopyLocalItems.Filename)%(NativeCopyLocalItems.Extension)' == 'libhypercast.a'" />
    </ItemGroup>
  </Target>

  <!-- Native AOT: link the core in.

       A Native AOT publish used to produce an executable with libhypercast.so (or the .dylib,
       or the .dll) sitting beside it, opened on first use like any other P/Invoke. Here it is
       linked into the executable instead: DirectPInvoke tells the AOT compiler to bind every
       import from "hypercast" as a direct call to a symbol the linker must resolve, and
       NativeLibrary hands the linker the archive that defines them. The result is one file,
       and calls that are plain calls, with no lazy binding stub in front of them.

       The archives are in staticlibs/{rid}/, one per RID the package carries a shared
       library for, built without Rust's standard library so that this package and
       HyperCast's can both be linked into one executable (the same collision, and the same
       fix, as the Blazor WebAssembly archive above).

       Presence decides. Where the package has no archive for the RID being published — a
       RID it has never heard of, or a package built before these existed — nothing here
       applies and the publish loads the shared library exactly as it always did. Setting
       HyperCastStaticLink to false asks for that on purpose.

       Not for browser-wasm, which has its own wiring above, and not for anything but an AOT
       publish: a JIT process cannot link an archive, so it still loads the shared library. -->
  <PropertyGroup Condition="'$(PublishAot)' == 'true' And '$(RuntimeIdentifier)' != '' And '$(RuntimeIdentifier)' != 'browser-wasm' And '$(HyperCastStaticLink)' != 'false'">
    <_HyperCastStaticLibrary Condition="$(RuntimeIdentifier.StartsWith('win'))">$(MSBuildThisFileDirectory)../staticlibs/$(RuntimeIdentifier)/hypercast.lib</_HyperCastStaticLibrary>
    <_HyperCastStaticLibrary Condition="!$(RuntimeIdentifier.StartsWith('win'))">$(MSBuildThisFileDirectory)../staticlibs/$(RuntimeIdentifier)/libhypercast.a</_HyperCastStaticLibrary>
    <_HyperCastStaticLibrary Condition="!Exists('$(_HyperCastStaticLibrary)')"></_HyperCastStaticLibrary>
  </PropertyGroup>

  <ItemGroup Condition="'$(_HyperCastStaticLibrary)' != ''">
    <DirectPInvoke Include="hypercast" />
    <NativeLibrary Include="$(_HyperCastStaticLibrary)" />
  </ItemGroup>

  <!-- With the core linked in, the shared library is dead weight in the publish directory:
       nothing opens it. It gets there two ways — NuGet's runtimes/{rid}/native/ asset for a
       package consumer, a copy-to-output item for a project reference — and both end up in
       @(ResolvedFileToPublish), which is where it is taken back out. By file name, since
       that is all the two routes have in common; the managed assembly is HyperCast.Managed.dll
       and is not in an AOT publish anyway. -->
  <Target Name="_HyperCastDropSharedLibraryFromAotPublish"
          AfterTargets="ComputeResolvedFilesToPublishList"
          Condition="'$(_HyperCastStaticLibrary)' != ''">
    <ItemGroup>
      <_HyperCastSharedLibrary Include="@(ResolvedFileToPublish)"
                         Condition="'%(Filename)%(Extension)' == 'libhypercast.so' Or '%(Filename)%(Extension)' == 'libhypercast.dylib' Or '%(Filename)%(Extension)' == 'hypercast.dll'" />
      <ResolvedFileToPublish Remove="@(_HyperCastSharedLibrary)" />
    </ItemGroup>
  </Target>
</Project>
