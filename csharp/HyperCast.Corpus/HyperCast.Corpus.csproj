<Project Sdk="Microsoft.NET.Sdk">

  <!-- The conformance corpus (corpus/*.json at the repository root) as a content-only NuGet
       package, versioned in lockstep with HyperCast itself: a downstream suite that routes its
       own parsers through HyperCast can replay the exact vectors this version of the core was
       proven against, without vendoring thirteen JSON files by hand and tracking a snapshot SHA
       beside them. Svartalfheim's ingestion branch did exactly that vendoring, which is why this
       package exists. No assembly ships — contentFiles only, copied to the consumer's output
       under HyperCastCorpus/ so a test can open them relative to AppContext.BaseDirectory. -->
  <PropertyGroup>
    <PackageId>HyperCast.Corpus</PackageId>
    <!-- Bumped by prepare-release.yml in the same sweep as HyperCast.csproj: the corpus a
         consumer replays must be the one its HyperCast package was proven against. -->
    <Version>0.2.0</Version>
    <Description>HyperCast's cross-language conformance corpus (corpus/*.json) as content files, versioned in lockstep with the HyperCast package — replay the same vectors the native core, and every binding, are proven against.</Description>
    <Authors>Brian Buvinghausen</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/SkunkWerkx/HyperCast</PackageProjectUrl>
    <RepositoryUrl>https://github.com/SkunkWerkx/HyperCast</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>parsing;conformance;corpus;test-data</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- Content only: no lib/ folder, no dependency group, nothing to compile. -->
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <!-- NU5128: a package with no lib/ folder gets a warning about the missing TFM group,
         which is precisely the shape of a content-only package. -->
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- contentFiles/any/any/ so every TFM and language receives them; BuildAction None and
         copy-to-output so they land as loose files beside the consumer's test binary. -->
    <Content Include="../../corpus/*.json"
             Pack="true"
             PackagePath="contentFiles/any/any/HyperCastCorpus/%(Filename)%(Extension)"
             BuildAction="None"
             CopyToOutput="true"
             PackageCopyToOutput="true"
             Link="HyperCastCorpus/%(Filename)%(Extension)" />
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="../../LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
