<Project>

	<PropertyGroup>
		<!-- .NET 10 and 11, from one source. Verdict<T> is a native discriminated union
		     ([Union]/IUnion + case-type pattern matching), which is what makes its disposition
		     handling compiler-checked: C# 15 (LangVersion preview, on either SDK) builds the
		     unions for net10.0 too, through HyperCast/Polyfill.cs's internal UnionAttribute and
		     IUnion, which net10.0's BCL lacks. CS8509 (non-exhaustive switch expression) is
		     elevated to an error so an unhandled verdict case is a build failure, not a review
		     nit — the entire point of returning a union instead of throwing. The mobile smoke
		     tests, the gate probe and the benchmarks set their own frameworks. -->
		<TargetFrameworks>net10.0;net11.0</TargetFrameworks>
		<LangVersion>preview</LangVersion>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<WarningsAsErrors>$(WarningsAsErrors);CS8509</WarningsAsErrors>
	</PropertyGroup>

</Project>
